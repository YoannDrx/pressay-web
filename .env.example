# Identity: Better Auth is the only provider. Set AUTH_PROVIDER=disabled to
# switch sign-in off; any other value follows the Better Auth configuration.
AUTH_PROVIDER=better-auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_PASSKEY_RP_ID=localhost
DATABASE_URL=postgresql://USER:PASSWORD@HOST/pressay?sslmode=verify-full
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Optional until the Apple Developer identifiers and key are provisioned.
APPLE_CLIENT_ID=fr.yodev.pressay.web
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
APPLE_APP_BUNDLE_IDENTIFIER=fr.yodev.pressay
PRESSAY_MACOS_OAUTH_CLIENT_ID=w9ckUgrcFp7H7wNV
PRESSAY_OAUTH_RESOURCE=https://api.press-say.app
PRESSAY_INTERNAL_JWT_SECRET=GENERATE_A_DIFFERENT_32_CHARACTER_SECRET
PRESSAY_INTERNAL_JWT_ISSUER=https://press-say.app/internal
# Cloud -> web calls (POST /api/internal/identity-deletion) are signed with the
# same PRESSAY_INTERNAL_JWT_SECRET under this issuer; must match the Cloud.
PRESSAY_CLOUD_INTERNAL_JWT_ISSUER=https://api.press-say.app/internal
# Audience of server-side proxy tokens; must match the Cloud's
# PRESSAY_WEB_PROXY_JWT_AUDIENCE.
PRESSAY_WEB_PROXY_JWT_AUDIENCE=pressay-web-proxy
# Public support address shown on legal and help pages (optional; a built-in
# default is used when unset).
NEXT_PUBLIC_SUPPORT_EMAIL=

# Signed build/deployment manifest. Checkout remains closed unless all
# production values match the canonical Pressay web and Cloud projects.
PRESSAY_WEB_ENVIRONMENT=development
PRESSAY_WEB_CANONICAL_ORIGIN=http://localhost:3000
PRESSAY_API_URL=https://api-staging.press-say.app/v1
COMMERCIAL_CHECKOUT_ENABLED=false
# Comma-separated release evidence allowlist. Keep empty until each named
# capability has passed its native, privacy and commercial release gates.
PRESSAY_PUBLIC_VALIDATED_CAPABILITIES=
